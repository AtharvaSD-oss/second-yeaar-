generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Application {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id") @db.Uuid
  company         String
  role            String
  location        String?
  region          String?  @default("India")
  state           String?
  workMode        String?  @map("work_mode")
  applicationDate String?  @map("application_date")
  deadline        String?
  applicationUrl  String?  @map("application_url")
  stipend         String?
  duration        String?
  skills          Json?    @default("[]")
  status          String?  @default("Saved")
  priority        String?  @default("Medium")
  favorite        Boolean? @default(false)
  notes           String?
  interview       Json?    @default("{}")
  followUpDate    String?  @map("follow_up_date")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("applications")
}
